# Stripe test-mode credentials — safe to commit (private repo, test keys only, no real charges)
# Students: these are loaded automatically by `npm run dev`. No manual setup needed.
# If you have your own Stripe test account, add STRIPE_SECRET_KEY to .env.development
# and it will override this value.
STRIPE_SECRET_KEY=sk_test_REMOVED
NEXT_PUBLIC_SITE_URL=http://localhost:3032
