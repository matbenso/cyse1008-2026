NEXT_PUBLIC_FIREBASE_APPID=1:926293242580:web:15daa4f180841dbc3c0141

NEXT_PUBLIC_FIREBASE_EMULATOR=true

# Server-side — tells firebase-admin (used in API routes) to use the local emulator.
# Without these, API routes try to reach real Google Cloud and demand credentials.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# GitHub Codespaces — set this to $CODESPACE_NAME in your Codespaces environment.
# Leave blank or unset when running locally.
NEXT_PUBLIC_CODESPACE_NAME=

# Add your own after running: stripe listen --forward-to localhost:3032/api/stripe/webhook
